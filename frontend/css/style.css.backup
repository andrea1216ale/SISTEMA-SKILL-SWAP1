*
{

margin:0;
padding:0;
box-sizing:border-box;

}



body{

font-family:Arial, sans-serif;

}



/* FONDO */

.background{


height:100vh;

display:flex;

justify-content:flex-end;

align-items:center;


padding-right:120px;


/* AQUÍ CAMBIAS TU IMAGEN */

background-image:url("/img/banerprincipal.png");


background-size:cover;

background-position:center;


}



/* TARJETA LOGIN */


.login-card{


width:360px;


background:white;


padding:40px;


border-radius:20px;


box-shadow:0 15px 40px rgba(0,0,0,0.2);


text-align:center;


}



.login-card h1{


font-size:38px;

color:#2563eb;

margin-bottom:15px;


}



.login-card h2{


font-size:25px;

margin-bottom:10px;


}



.login-card p{


color:#666;

font-size:15px;

margin-bottom:30px;


}



form{


display:flex;

flex-direction:column;


}



input{


padding:14px;


margin-bottom:18px;


border:1px solid #ddd;


border-radius:10px;


font-size:15px;


}



button{


padding:14px;


background:#2563eb;


color:white;


border:none;


border-radius:10px;


font-size:17px;


cursor:pointer;


margin-bottom:20px;


}



button:hover{


background:#1d4ed8;


}



a{


color:#2563eb;

text-decoration:none;


font-size:14px;


}



span{


margin-top:25px;


font-size:14px;


color:#555;


}

.register-card{


width:700px;

background:white;

padding:40px;

border-radius:20px;

box-shadow:0 15px 40px rgba(0,0,0,0.25);

}


.register-card h1{

text-align:center;

color:#2563eb;

font-size:40px;

}


.register-card h2{

text-align:center;

margin:10px;

}


.register-card p{

text-align:center;

color:#666;

margin-bottom:25px;

}



.row{


display:flex;

gap:20px;


}



.row input{


width:50%;


}



.register-card input,
.register-card select{


padding:14px;

border-radius:10px;

border:1px solid #ddd;

margin-bottom:15px;

font-size:15px;


}

